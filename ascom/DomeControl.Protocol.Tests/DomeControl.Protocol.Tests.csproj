<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DomeControl.Protocol.Tests</RootNamespace>
    <AssemblyName>DomeControl.Protocol.Tests</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- See the comment in ../DomeControl.Protocol.csproj: no packages, no audit, no network. -->
    <NuGetAudit>false</NuGetAudit>
    <!-- No NuGet packages on purpose: `dotnet run` must work offline, so this is a console runner
         with its own Assert rather than a test framework (AGENTS.md §6). -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DomeControl.Protocol\DomeControl.Protocol.csproj" />
  </ItemGroup>

</Project>